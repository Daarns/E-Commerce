# Server Configuration
PORT=8080
ENV=development
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-token-key-generate-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-generate-with-openssl-rand-base64-32
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Email (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ecommerce.local

# Payment Gateway (Mock for development)
PAYMENT_GATEWAY_URL=https://api.sandbox.midtrans.com
PAYMENT_API_KEY=your-midtrans-api-key

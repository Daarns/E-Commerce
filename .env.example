# E-Commerce Platform - Environment Configuration

# App Settings
APP_ENV=development
APP_PORT=8080
APP_NAME=E-Commerce API

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecommerce_user
DB_PASSWORD=your_db_password
DB_NAME=ecommerce_db
DB_SSL_MODE=disable

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7 * 24h

# Email Service Configuration (SMTP)
# For Gmail, use these settings:
# 1. Enable 2-step verification on Gmail
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Set SMTP_USER and SMTP_PASSWORD below

SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourstore.com

# Alternative: Gmail with fallback variables
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3001

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Payment Gateway (Midtrans/Stripe)
PAYMENT_GATEWAY=midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key

# AWS/Cloud Storage (if using S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your_bucket_name

# Feature Flags
ENABLE_SOCKET_IO=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_NEWSLETTER=true
